{
  "manifest_version": 3,
  "name": "Marp F20 Navigation",
  "version": "1.0",
  "description": "Adds F20 key navigation to Marp presentations",
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["file://*/*.html", "http://*/*.html", "https://*/*.html"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Marp F20 Navigation"
  }
}